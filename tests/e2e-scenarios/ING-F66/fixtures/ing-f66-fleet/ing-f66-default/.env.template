# Environment variables for this Hermes coworker distribution.
# The installer renames this file to .env.EXAMPLE; copy it to .env and
# fill in real values before running.

# Fleet raw-request-capture default: dump preflight request payloads and
# terminal API-error response bodies (secret-redacted) beside each session
# file. This documents the default; the active .env the installer writes is
# what enables capture for spawned surfaces. See the fleet raw-request-
# capture runbook (website/docs/user-guide/fleet-raw-request-capture.md).
HERMES_DUMP_REQUESTS=true
