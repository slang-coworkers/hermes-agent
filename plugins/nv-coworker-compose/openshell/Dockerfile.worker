# Worker-sandbox image — one per served profile, reached over the builtin ssh terminal
# backend. Route (a): the gateway brokers ssh via `ProxyCommand openshell ssh-proxy` and
# auth rides the OpenShell mTLS proxy, so this image carries NO sshd and NO key material;
# the rendered `terminal.ssh_key` need only EXIST for the `-i` contract, never for auth.
#
# The base is pinned by immutable digest (the multi-arch index) so the sandbox is
# reproducible, on the Python line the gateway's Hermes runs on (3.14 at v0.22.0); the
# worker only needs a shell + the tools its terminal calls use (hermes runs on the
# gateway, not in the worker), so no Hermes runtime is installed here. An operator on a
# different registry substitutes their own digest-pinned base at provisioning (see
# website/docs/user-guide/fleet-openshell.md § "install into an existing NemoClaw sandbox").
FROM ghcr.io/astral-sh/uv:0.11.6-python3.14-trixie@sha256:f3b1d933a49112e15fb02a24f9bfc8fef9986351afc601fcaba4c01a9b6a0eac

ENV DEBIAN_FRONTEND=noninteractive

# The tools a profile's terminal calls need inside its sandbox. No upgrade (the base is
# pinned), --no-install-recommends, and the apt lists are dropped to keep the image lean.
# iproute2 (`ip`) is required by OpenShell 0.0.72: without it the sandbox never reaches
# Ready (supervisor: "trusted ip helper not found; checked /usr/sbin/ip"). gh is the Debian
# archive package, version-pinned, installed at /usr/bin/gh (the path the github provider
# policy names); a worker opens and reads pull requests with it.
RUN apt-get update \
 && apt-get install --no-install-recommends -y \
      ca-certificates \
      curl \
      gh=2.46.0-3 \
      git \
      iproute2 \
      ripgrep \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Run as an unprivileged user — a profile's terminal calls never need root in the sandbox.
RUN useradd --create-home --uid 10001 --shell /bin/bash sandbox \
 && chown -R sandbox:sandbox /workspace

# git reads the GitHub credential section the render ships in a provider-opted profile's
# skills/ tree, which the ssh terminal backend syncs into ~/.hermes/skills. git skips a missing
# include target, so a worker without that file (approver, orchestrator) is unaffected.
RUN git config --system include.path /home/sandbox/.hermes/skills/nv-gitconfig/gitconfig-github
# The provider exposes its session credential under its own name, which the GitHub CLI does not
# read; the ssh terminal's login shell maps it (value-free, only when present).
COPY profile.d/nv-github-session.sh /etc/profile.d/nv-github-session.sh
USER sandbox
